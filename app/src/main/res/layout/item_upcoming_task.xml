<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"

    android:layout_width="250dp"
    android:layout_height="170dp"

    android:layout_marginEnd="16dp"

    android:orientation="vertical"

    android:padding="22dp"

    android:background="@drawable/bg_deadline_card">


    <!-- TOP -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"

        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tvPriority"

            android:layout_width="0dp"
            android:layout_height="wrap_content"

            android:layout_weight="1"

            android:text="Office Project"

            android:textColor="@color/text_secondary"

            android:textSize="13sp"/>


        <TextView

            android:layout_width="34dp"
            android:layout_height="34dp"

            android:gravity="center"

            android:text="👜"

            android:textSize="16sp"

            android:background="@drawable/bg_progress_circle"/>

    </LinearLayout>



    <!-- TITLE -->

    <TextView
        android:id="@+id/tvTitle"

        android:layout_width="match_parent"
        android:layout_height="wrap_content"

        android:layout_marginTop="20dp"

        android:text="Design ADR"

        android:textColor="@color/text_primary"

        android:textSize="24sp"

        android:textStyle="bold"/>



    <!-- DEADLINE -->

    <TextView
        android:id="@+id/tvDeadline"

        android:layout_width="wrap_content"
        android:layout_height="wrap_content"

        android:layout_marginTop="12dp"

        android:text="2h left"

        android:textColor="@color/text_secondary"

        android:textSize="14sp"/>



    <!-- PROGRESS -->

    <ProgressBar

        android:id="@+id/pbProgress"

        style="?android:attr/progressBarStyleHorizontal"

        android:layout_width="match_parent"

        android:layout_height="6dp"

        android:layout_marginTop="28dp"

        android:max="100"

        android:progress="70"

        android:progressTint="@color/status_todo_text"

        android:backgroundTint="#ECECEC"/>


</LinearLayout>