<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"

    android:layout_width="match_parent"
    android:layout_height="match_parent"

    android:fillViewport="true"

    android:background="@color/background_main">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"

        android:orientation="vertical"

        android:paddingHorizontal="22dp"

        android:paddingTop="26dp"

        android:paddingBottom="120dp">



        <!-- HEADER -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:gravity="center_vertical">

            <View
                android:layout_width="58dp"
                android:layout_height="58dp"

                android:background="@drawable/bg_progress_circle"/>


            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"

                android:layout_marginStart="14dp"

                android:layout_weight="1"

                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    android:text="Hello!"

                    android:textColor="@color/text_secondary"

                    android:textSize="14sp"/>


                <TextView
                    android:id="@+id/tvUserName"

                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    android:text="Welcome"

                    android:textColor="@color/text_primary"

                    android:textSize="32sp"

                    android:textStyle="bold"/>

            </LinearLayout>



            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"

                android:padding="12dp"

                android:background="@drawable/bg_progress_circle"

                android:src="@android:drawable/ic_dialog_info"/>

        </LinearLayout>





        <!-- HERO -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="220dp"

            android:layout_marginTop="26dp"

            android:background="@drawable/bg_home_hero"

            android:orientation="horizontal"

            android:padding="24dp">


            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"

                android:layout_weight="1"

                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    android:text="Your today's task&#10;almost done!"

                    android:textColor="@color/white"

                    android:textSize="26sp"

                    android:textStyle="bold"/>


                <TextView
                    android:id="@+id/tvTodayProgress"

                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    android:layout_marginTop="14dp"

                    android:textColor="@color/white"

                    android:textSize="15sp"/>


                <Button
                    android:id="@+id/btnViewCalendar"

                    android:layout_width="150dp"
                    android:layout_height="56dp"

                    android:layout_marginTop="26dp"

                    android:text="View Task"

                    android:textAllCaps="false"

                    android:textColor="@color/primary_color"

                    android:textStyle="bold"

                    android:backgroundTint="@color/primary_light"/>

            </LinearLayout>





            <!-- FIGMA CIRCLE -->

            <FrameLayout
                android:layout_width="130dp"
                android:layout_height="130dp"

                android:layout_gravity="center">


                <com.google.android.material.progressindicator.CircularProgressIndicator
                    android:id="@+id/circleProgress"

                    android:layout_width="match_parent"
                    android:layout_height="match_parent"

                    android:max="100"

                    android:indeterminate="false"

                    app:indicatorSize="130dp"

                    app:indicatorInset="0dp"

                    app:trackThickness="8dp"

                    app:indicatorColor="@color/white"

                    app:trackColor="#8664F0"/>


                <TextView
                    android:id="@+id/tvPercent"

                    android:layout_width="match_parent"
                    android:layout_height="match_parent"

                    android:gravity="center"

                    android:text="85%"

                    android:textColor="@color/white"

                    android:textSize="30sp"

                    android:textStyle="bold"/>

            </FrameLayout>

        </LinearLayout>





        <!-- IN PROGRESS -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:layout_marginTop="34dp"

            android:text="In Progress"

            android:textSize="30sp"

            android:textStyle="bold"

            android:textColor="@color/text_primary"/>


        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvUpcoming"

            android:layout_width="match_parent"

            android:layout_height="190dp"

            android:layout_marginTop="16dp"/>





        <!-- GROUP -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:layout_marginTop="32dp"

            android:text="Task Groups"

            android:textSize="30sp"

            android:textStyle="bold"

            android:textColor="@color/text_primary"/>


        <LinearLayout
            android:id="@+id/layoutPriority"

            android:layout_width="match_parent"

            android:layout_height="wrap_content"

            android:layout_marginTop="16dp"

            android:orientation="vertical">

            <include
                android:id="@+id/cardHigh"
                layout="@layout/item_priority_group"/>

            <include
                android:id="@+id/cardMedium"
                layout="@layout/item_priority_group"/>

            <include
                android:id="@+id/cardLow"
                layout="@layout/item_priority_group"/>

        </LinearLayout>

    </LinearLayout>

</ScrollView>